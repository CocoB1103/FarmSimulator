# ===== Unreal Engine =====

# Visual Studio / Rider generated project files
.vs/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
.vsconfig
*.xcodeproj
*.xcworkspace

# Build / intermediate / binaries (fully regenerated by compiling the project)
Binaries/
Intermediate/
DerivedDataCache/
Build/
.ubtmemoryusage
*.target

# Saved folder: logs, autosaves, save games, per-user editor settings
Saved/

# Plugin intermediates
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Python automation cache
PyAutomation/__pycache__/

# OS files
.DS_Store
Thumbs.db
